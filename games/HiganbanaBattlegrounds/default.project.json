{
  "name": "HiganbanaBattlegrounds",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": { "$path": "src/shared" },
      "Remotes": {
        "$className": "Folder",
        "Action": { "$className": "RemoteEvent" },
        "SetBlock": { "$className": "RemoteEvent" },
        "Dash": { "$className": "RemoteEvent" },
        "Mend": { "$className": "RemoteEvent" },
        "SelectFighter": { "$className": "RemoteEvent" },
        "MoveFx": { "$className": "RemoteEvent" },
        "PhaseFx": { "$className": "RemoteEvent" },
        "HitFx": { "$className": "RemoteEvent" },
        "ProjectileFx": { "$className": "RemoteEvent" },
        "ElderFx": { "$className": "RemoteEvent" },
        "Impulse": { "$className": "RemoteEvent" },
        "Teleport": { "$className": "RemoteEvent" },
        "Notify": { "$className": "RemoteEvent" }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "CameraMaxZoomDistance": 45,
        "EnableMouseLockOption": true,
        "CharacterWalkSpeed": 16
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": { "$path": "src/client" }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": false,
        "FallenPartsDestroyHeight": -500
      }
    },
    "Players": {
      "$className": "Players",
      "$properties": { "RespawnTime": 4, "CharacterAutoLoads": true }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future",
        "ClockTime": 17.72,
        "GeographicLatitude": 18,
        "Brightness": 2.6,
        "ExposureCompensation": 0.35,
        "Ambient": [0.31, 0.24, 0.3],
        "OutdoorAmbient": [0.59, 0.46, 0.49],
        "ColorShift_Top": [1, 0.6, 0.45],
        "ColorShift_Bottom": [0.25, 0.35, 0.5],
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 1,
        "GlobalShadows": true,
        "ShadowSoftness": 0.3
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.36,
          "Offset": 0.12,
          "Color": [0.89, 0.57, 0.47],
          "Decay": [0.5, 0.27, 0.38],
          "Glare": 0.8,
          "Haze": 3.2
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": { "Intensity": 0.8, "Size": 32, "Threshold": 1.05 }
      },
      "Grade": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Brightness": 0.03,
          "Contrast": 0.12,
          "Saturation": 0.12,
          "TintColor": [1, 0.9, 0.95]
        }
      },
      "SunRays": {
        "$className": "SunRaysEffect",
        "$properties": { "Intensity": 0.08, "Spread": 0.55 }
      }
    },
    "SoundService": { "$className": "SoundService" },
    "StarterGui": { "$className": "StarterGui" }
  }
}
