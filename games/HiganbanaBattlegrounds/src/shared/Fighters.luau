Fighters.LIST = { TSUTA, HIBIKI, IWAO, KANEMORI, ROKUMON } :: { FighterSpec }
Fighters.DEFAULT_ID = TSUTA.id

local byId: { [string]: FighterSpec } = {}
local byPhase: { [string]: FighterSpec } = {}
for _, fighter in Fighters.LIST do
	byId[fighter.id] = fighter
	byPhase[fighter.phase] = fighter
end

function Fighters.get(id: string?): FighterSpec?
	if id == nil then
		return nil
	end
	return byId[id]
end

function Fighters.getOrDefault(id: string?): FighterSpec
	return (id and byId[id]) or TSUTA
end

function Fighters.forPhase(phase: string): FighterSpec?
	return byPhase[phase]
end

function Fighters.moveForSlot(fighter: FighterSpec, slot: string): MoveSpec?
	for _, move in fighter.moves do
		if move.slot == slot then
			return move
		end
	end
	return nil
end

function Fighters.findMove(fighter: FighterSpec, moveId: string): MoveSpec?
	for _, move in fighter.moves do
		if move.id == moveId then
			return move
		end
	end
	return nil
end

-- M1 chain hits are addressed as "M1_1" .. "M1_4".
function Fighters.m1MoveId(index: number): string
	return `M1_{index}`
end

function Fighters.parseM1(moveId: string): number?
	local index = string.match(moveId, "^M1_(%d)$")
	return if index then tonumber(index) else nil
end

return Fighters
