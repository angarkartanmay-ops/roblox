--!strict
-- The five souls of the Far Shore, one per phase. Pure data plus lookups: the server executes these
-- specs and clients render them. Numbers are the contract in design/game.json `roster`; hit times sit
-- on the contact markers in design/animations.json.

local Types = require("./Types")

type FighterSpec = Types.FighterSpec
type MoveSpec = Types.MoveSpec
type SlotId = Types.SlotId

local Fighters = {}

Fighters.SLOTS = { "Ability1", "Ability2", "Ability3", "Ability4", "Ultimate" } :: { SlotId }

-- Typed constructors: they give each nested hit and projectile literal its expected type (the type
-- checker does not carry it through the roster's deeply nested arrays on its own).
local function hit(spec: Types.HitSpec): Types.HitSpec
	return spec
end

local function shot(spec: Types.ProjectileSpec): Types.ProjectileSpec
	return spec
end

