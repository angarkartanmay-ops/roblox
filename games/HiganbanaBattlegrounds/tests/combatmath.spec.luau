--!strict
-- Pure combat rules: damage through the phases, guard, parry, Ki and Mend, passives, the Elder's
-- heart and reward, geometry and movement.

local Harness = require("./harness")
local CombatMath = require("../src/shared/CombatMath")
local Constants = require("../src/shared/Constants")

local describe, it, expect = Harness.describe, Harness.it, Harness.expect

describe("Damage", function()
	it("applies the phase relation", function()
		expect(CombatMath.damage(10, { relation = "Neutral" })):toBe(10)
		expect(CombatMath.damage(10, { relation = "Overcome" })):toBe(12)
		expect(CombatMath.damage(10, { relation = "Resisted" })):toBe(8.5)
		expect(CombatMath.damage(10, { relation = "Feeding" })):toBe(9)
		expect(CombatMath.damage(10, { relation = "Drawing" })):toBe(10)
	end)

	it("applies buffs and clamps armour", function()
		expect(CombatMath.damage(10, { attackerMultiplier = 1.1 })):toBe(11)
		expect(CombatMath.damage(10, { defenderArmor = 0.5 })):toBe(5)
		expect(CombatMath.damage(10, { defenderArmor = 5 })):toBe(1)
	end)

	it("blocks M1s fully and abilities partly", function()
		expect(CombatMath.damage(10, { blocked = true, isM1 = true })):toBe(0)
		expect(CombatMath.damage(10, { blocked = true })):toBe(10 * Constants.BLOCK_ABILITY_FACTOR)
	end)

	it("rejects bad input", function()
		expect(CombatMath.damage(-3, {})):toBe(0)
		expect(CombatMath.damage(0 / 0, {})):toBe(0)
		expect(CombatMath.damage(math.huge, {})):toBe(0)
	end)

	it("drains guard harder on an overcoming hit and on Iron Edict", function()
		local base = CombatMath.guardDamage(10, "Neutral")
		expect(base):toBe(10 * Constants.GUARD_PER_DAMAGE)
		expect(CombatMath.guardDamage(10, "Overcome")):toBe(base * Constants.OVERCOME_GUARD)
		expect(CombatMath.guardDamage(10, "Neutral", 2)):toBe(base * 2)
	end)

	it("parries only M1s inside the window", function()
		expect(CombatMath.isParry(10, 10.1, true)):toBeTruthy()
		expect(CombatMath.isParry(10, 10 + Constants.PARRY_WINDOW + 0.01, true)):toBeFalsy()
		expect(CombatMath.isParry(10, 10.1, false)):toBeFalsy()
		expect(CombatMath.isParry(nil, 10.1, true)):toBeFalsy()
	end)

	it("regenerates guard only after the delay", function()
		expect(CombatMath.regenGuard(50, 1, 0.5)):toBe(50)
		expect(CombatMath.regenGuard(50, 1, 5)):toBe(50 + Constants.GUARD_REGEN)
		expect(CombatMath.regenGuard(99, 1, 5)):toBe(Constants.GUARD_MAX)
	end)
end)

describe("Ki", function()
	it("earns Ki for dealing and taking damage", function()
		local dealt, taken = CombatMath.kiForHit(10, "Neutral")
		expect(dealt):toBe(10 * Constants.KI_PER_DAMAGE_DEALT)
		expect(taken):toBe(10 * Constants.KI_PER_DAMAGE_TAKEN)
	end)

	it("Drawing gives the attacker +50%; Feeding feeds the target", function()
		local drawn = CombatMath.kiForHit(10, "Drawing")
		expect(drawn):toBe(15)
		local fed, fedTarget = CombatMath.kiForHit(10, "Feeding")
		expect(fed):toBe(10)
		expect(fedTarget):toBe(10 * Constants.KI_PER_DAMAGE_TAKEN + 10 * Constants.FEEDING_KI_TO_TARGET)
	end)

	it("clamps the meter", function()
		expect(CombatMath.addKi(95, 20)):toBe(Constants.KI_MAX)
		expect(CombatMath.addKi(5, -20)):toBe(0)
		expect(CombatMath.addKi(40, 0 / 0)):toBe(40)
	end)

	it("mends at the configured rate without overspending", function()
		local spent, healed = CombatMath.mendStep(100, 50, 1)
		expect(spent):toBe(Constants.MEND_KI_PER_SECOND)
		expect(healed):toBe(Constants.MEND_KI_PER_SECOND * Constants.MEND_HEALTH_PER_KI)
		local spentShort = CombatMath.mendStep(5, 50, 1)
		expect(spentShort, "never more than held"):toBe(5)
		local spentFull = CombatMath.mendStep(100, 3, 1)
		expect(spentFull, "never past full health"):toBe(3)
		local spentSap = CombatMath.mendStep(100, 50, 1, Constants.ELDER_SAP_MEND)
		expect(spentSap):toBeNear(Constants.MEND_KI_PER_SECOND * 1.2, 1e-9)
		expect(CombatMath.mendStep(0, 50, 1)):toBe(0)
	end)

	it("locks Mend out after a hit and while Purified", function()
		expect(CombatMath.canMend(10, 10 - Constants.MEND_LOCKOUT, 0)):toBeTruthy()
		expect(CombatMath.canMend(10, 9, 0)):toBeFalsy()
		expect(CombatMath.canMend(10, 0, 12)):toBeFalsy()
	end)
end)

describe("Passives", function()
	it("Rhythm: every third hit inside the window is a Beat", function()
		local count, beat = CombatMath.rhythm(0, nil, 1)
		expect(count):toBe(1)
		expect(beat):toBeFalsy()
		count, beat = CombatMath.rhythm(count, 1, 1.5)
		expect(beat):toBeFalsy()
		count, beat = CombatMath.rhythm(count, 1.5, 2)
		expect(count):toBe(3)
		expect(beat):toBeTruthy()
		count, beat = CombatMath.rhythm(count, 2, 2 + Constants.HIBIKI_RHYTHM_WINDOW + 0.1)
		expect(count, "a gap restarts the count"):toBe(1)
		expect(beat):toBeFalsy()
		local _, forced = CombatMath.rhythm(1, 2, 2.1, true)
		expect(forced, "Kakegoe forces a Beat"):toBeTruthy()
	end)

	it("Fare: a coin every sixth hit, at most six", function()
		local hits, coins = 0, 0
		for _ = 1, Constants.ROKUMON_HITS_PER_COIN - 1 do
			hits, coins = CombatMath.fare(hits, coins)
		end
		expect(coins):toBe(0)
		hits, coins = CombatMath.fare(hits, coins)
		expect(coins):toBe(1)
		expect(hits):toBe(0)
		local _, capped = CombatMath.fare(Constants.ROKUMON_HITS_PER_COIN - 1, Constants.ROKUMON_MAX_COINS)
		expect(capped):toBe(Constants.ROKUMON_MAX_COINS)
		expect(CombatMath.tollDamage(8, 3)):toBe(8 + 3 * Constants.ROKUMON_TOLL_PER_COIN)
		expect(CombatMath.tollDamage(8, 99)):toBe(8 + Constants.ROKUMON_MAX_COINS * Constants.ROKUMON_TOLL_PER_COIN)
	end)

	it("Sprout bursts at three stacks", function()
		local stacks, burst = CombatMath.sprout(0)
		expect(stacks):toBe(1)
		expect(burst):toBeFalsy()
		stacks, burst = CombatMath.sprout(Constants.TSUTA_SPROUT_BURST - 1)
		expect(stacks):toBe(0)
		expect(burst):toBeTruthy()
	end)

	it("Rooted: Iwao takes 30% less knockback", function()
		expect(CombatMath.knockbackTaken("Iwao")):toBe(Constants.IWAO_KNOCKBACK_TAKEN)
		expect(CombatMath.knockbackTaken("Tsuta")):toBe(1)
		expect(CombatMath.knockbackTaken(nil)):toBe(1)
	end)
end)

describe("The Thirsting Elder", function()
	it("is wounded only by the overcoming phase and fed by the generating one", function()
		local kind, damage, heal = CombatMath.elderHit(10, "Fire", "Metal")
		expect(kind):toBe("Wound")
		expect(damage):toBe(10 * Constants.ELDER_OVERCOME_BONUS)
		expect(heal):toBe(0)
		kind, damage, heal = CombatMath.elderHit(10, "Earth", "Metal")
		expect(kind):toBe("Feed")
		expect(damage):toBe(0)
		expect(heal):toBe(10 * Constants.ELDER_FEEDING_HEAL)
		kind, damage = CombatMath.elderHit(10, "Water", "Metal")
		expect(kind):toBe("Normal")
		expect(damage):toBe(10)
		kind, damage = CombatMath.elderHit(10, nil, "Metal")
		expect(kind):toBe("Normal")
		expect(damage):toBe(10)
	end)

	it("cycles its heart along the generating order", function()
		local period = Constants.ELDER_PHASE_SECONDS
		expect(CombatMath.heartPhase("Wood", 0, period)):toBe("Wood")
		expect(CombatMath.heartPhase("Wood", period - 0.1, period)):toBe("Wood")
		expect(CombatMath.heartPhase("Wood", period, period)):toBe("Fire")
		expect(CombatMath.heartPhase("Wood", period * 4, period)):toBe("Water")
		expect(CombatMath.heartPhase("Wood", period * 5, period)):toBe("Wood")
	end)

	it("scales health and the Thirst with the server", function()
		expect(CombatMath.elderHealth(3)):toBe(Constants.ELDER_HEALTH_BASE + 3 * Constants.ELDER_HEALTH_PER_PLAYER)
		expect(CombatMath.thirstThreshold(4)):toBe(Constants.THIRST_BASE + 4 * Constants.THIRST_PER_PLAYER)
	end)

	it("wakes only when thirsty, after the first wait and the cooldown", function()
		local need = CombatMath.thirstThreshold(2)
		expect(CombatMath.elderMayWake(need, 2, Constants.THIRST_FIRST_AWAKE, nil)):toBeTruthy()
		expect(CombatMath.elderMayWake(need - 1, 2, 999, nil)):toBeFalsy()
		expect(CombatMath.elderMayWake(need, 2, Constants.THIRST_FIRST_AWAKE - 1, nil)):toBeFalsy()
		expect(CombatMath.elderMayWake(need, 2, 999, Constants.THIRST_COOLDOWN_AFTER_FALL - 1)):toBeFalsy()
		expect(CombatMath.elderMayWake(need, 2, 999, Constants.THIRST_COOLDOWN_AFTER_FALL)):toBeTruthy()
		expect(CombatMath.elderMayWake(need * 10, 0, 999, nil), "never on an empty server"):toBeFalsy()
	end)

	it("rewards players over the share and names the top dealer", function()
		local earned, top = CombatMath.elderRewards({ A = 500, B = 100, C = 2 }, 2400)
		expect(#earned):toBe(2)
		expect(earned[1]):toBe("A")
		expect(earned[2]):toBe("B")
		expect(top):toBe("A")
		local none, nobody = CombatMath.elderRewards({}, 2400)
		expect(#none):toBe(0)
		expect(nobody == nil):toBeTruthy()
	end)
end)

describe("Chains, geometry and movement", function()
	it("chains M1s and resets", function()
		expect(CombatMath.nextComboIndex(0, nil, 0)):toBe(1)
		expect(CombatMath.nextComboIndex(1, 0, 0.5)):toBe(2)
		expect(CombatMath.nextComboIndex(2, 0, Constants.COMBO_RESET + 0.1)):toBe(1)
		expect(CombatMath.nextComboIndex(Constants.COMBO_HITS, 0, 0.2)):toBe(1)
	end)

	it("tests boxes, spheres and segments", function()
		expect(CombatMath.insideBox(1, 1, 1, 4, 4, 4, 0)):toBeTruthy()
		expect(CombatMath.insideBox(3, 0, 0, 4, 4, 4, 0)):toBeFalsy()
		expect(CombatMath.insideBox(3, 0, 0, 4, 4, 4, 1.5)):toBeTruthy()
		expect(CombatMath.insideSphere(3, 4, 0, 5, 0)):toBeTruthy()
		expect(CombatMath.insideSphere(3, 4, 0.1, 5, 0)):toBeFalsy()
		expect(CombatMath.segmentDistance(0, 1, 0, -1, 0, 0, 1, 0, 0)):toBeNear(1)
		expect(CombatMath.segmentDistance(5, 0, 0, -1, 0, 0, 1, 0, 0)):toBeNear(4)
	end)

	it("blocks only from the front", function()
		expect(CombatMath.blockFacesAttacker(0, -1, 0, -5)):toBeTruthy()
		expect(CombatMath.blockFacesAttacker(0, -1, 0, 5)):toBeFalsy()
		expect(CombatMath.blockFacesAttacker(0, -1, 0, 0)):toBeTruthy()
	end)

	it("derives walk speed from statuses", function()
		expect(CombatMath.movement(16, { stunned = false, blocking = false })):toBe(16)
		local rooted, rootedJump = CombatMath.movement(16, { stunned = false, blocking = false, rooted = true })
		expect(rooted):toBe(0)
		expect(rootedJump):toBeFalsy()
		expect(CombatMath.movement(16, { stunned = true, blocking = false })):toBe(Constants.STUN_WALK_SPEED)
		expect(CombatMath.movement(16, { stunned = false, blocking = true })):toBe(16 * Constants.BLOCK_WALK_FACTOR)
		local mending, mendJump = CombatMath.movement(16, { stunned = false, blocking = false, mending = true })
		expect(mending):toBe(16 * Constants.MEND_SPEED)
		expect(mendJump):toBeFalsy()
		expect(CombatMath.movement(10, { stunned = false, blocking = false, speedBonus = 0.2 })):toBeNear(12)
		expect(CombatMath.movement(10, { stunned = false, blocking = false, slowFactor = 0.6 })):toBeNear(6)
	end)

	it("pays Petals for kills and announces streaks", function()
		expect(CombatMath.killReward(1)):toBe(Constants.PETALS_PER_KILL)
		expect(CombatMath.killReward(4)):toBe(Constants.PETALS_PER_KILL + 2 * Constants.PETALS_PER_STREAK_STEP)
		expect(CombatMath.isStreakAnnounced(5)):toBeTruthy()
		expect(CombatMath.isStreakAnnounced(4)):toBeFalsy()
	end)
end)
